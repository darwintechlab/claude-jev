{
  "name": "claude-jev",
  "version": "0.1.1",
  "private": true,
  "description": "Claude Code plugin — Jev live typed decisions (mirror of opencode-openjev, no mock)",
  "type": "module",
  "scripts": {
    "build": "npm --workspace=mcp-server run build",
    "package:plugin": "npm run build && node scripts/package-plugin.mjs",
    "typecheck": "npm --workspace=mcp-server run typecheck",
    "test": "node --test test/*.test.mjs",
    "bench": "node bench/bench.mjs",
    "bench:eval": "node bench/eval.mjs"
  },
  "workspaces": ["mcp-server"],
  "engines": { "node": ">=20" }
}
