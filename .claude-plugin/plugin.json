{
  "name": "claude-jev",
  "version": "0.1.0",
  "description": "Jev System One for Claude Code — typed Choice/Noul/Score decisions via live TypeSafe API (same 5 tools as opencode-openjev, no mock).",
  "author": { "name": "OpenJev Contributors" },
  "homepage": "https://github.com/darwintechlab/claude-openjev",
  "repository": "https://github.com/darwintechlab/claude-openjev",
  "license": "MIT",
  "keywords": ["jev", "typesafe", "system-one", "claude-code", "mcp", "typed-decisions"],
  "mcpServers": {
    "jev": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-server/dist/index.js"],
      "env": {
        "TYPESAFE_API_KEY": "${TYPESAFE_API_KEY}",
        "JEV_MODEL": "${JEV_MODEL:-}"
      }
    }
  }
}
